---
const catalogUrl = 'https://categoria-productos.netlify.app/';

const highlights = [
  {
    title: 'Repuestos OEM',
    description: 'Piezas originales y de calidad certificada para vehículos Ford.',
  },
  {
    title: 'Stock disponible',
    description: 'Inventario listo para mantener y reparar sin demoras innecesarias.',
  },
  {
    title: 'Asesoría técnica',
    description: 'Te orientamos para elegir el repuesto correcto según tu modelo.',
  },
];
---

<section id="almacen" class="section warehouse">
  <div class="section-atmosphere" aria-hidden="true">
    <span class="floating-shape floating-shape--md" style="top: 16%; left: 5%; animation-delay: 0s"></span>
    <span class="floating-shape floating-shape--sm" style="top: 58%; right: 7%; animation-delay: 2s"></span>
    <span class="floating-shape floating-shape--lg" style="bottom: 10%; left: 10%; animation-delay: 4s"></span>
  </div>

  <div class="container warehouse-inner">
    <div class="warehouse-content">
      <span class="section-label reveal" style="--reveal-delay: 0s">Repuestos</span>
      <h2 class="section-title reveal" style="--reveal-delay: 0.12s">Almacén de repuestos</h2>
      <p class="warehouse-desc reveal" style="--reveal-delay: 0.22s">
        Contamos con un almacén de repuestos seleccionados para diagnóstico, mantenimiento y reparación.
        Compara opciones y encuentra la pieza adecuada para tu vehículo.
      </p>

      <ul class="warehouse-list">
        {highlights.map((item, i) => (
          <li class="reveal" style={`--reveal-delay: ${0.32 + i * 0.1}s`}>
            <span class="warehouse-check" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M20 6L9 17l-5-5"/>
              </svg>
            </span>
            <span>
              <strong>{item.title}</strong>
              {item.description}
            </span>
          </li>
        ))}
      </ul>

      <a
        href={catalogUrl}
        class="btn btn-primary reveal"
        style="--reveal-delay: 0.62s"
        target="_blank"
        rel="noopener noreferrer"
      >
        Comparar repuestos
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M16 3h5v5M8 21H3v-5M21 3l-7 7M3 21l7-7"/>
        </svg>
      </a>
    </div>

    <div class="warehouse-visual reveal-right" style="--reveal-delay: 0.18s" aria-hidden="true">
      <div class="warehouse-visual-wrap">
        <div class="pulse-ring pulse-ring--square"></div>
        <div class="pulse-ring pulse-ring--square pulse-ring--delay"></div>
        <div class="warehouse-panel card-lift">
          <div class="warehouse-icon-wrap">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 21h18"/>
              <path d="M5 21V8l7-5 7 5v13"/>
              <path d="M9 21v-6h6v6"/>
              <path d="M10 8h4"/>
            </svg>
          </div>
          <p class="warehouse-panel-text">Inventario y comparación de repuestos al alcance</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .warehouse {
    background: var(--bg-secondary);
    position: relative;
    overflow: clip;
  }

  .warehouse::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
  }

  .warehouse-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
  }

  .warehouse-desc {
    margin: 1rem 0 1.75rem;
    max-width: 520px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .warehouse-list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .warehouse-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    color: var(--text-secondary);
  }

  .warehouse-list strong {
    display: block;
    color: var(--text-primary);
    font-size: 0.95rem;
    margin-bottom: 0.15rem;
  }

  .warehouse-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    margin-top: 0.1rem;
    border-radius: var(--radius-sm);
    color: var(--accent);
    background: rgba(0, 52, 120, 0.1);
  }

  .warehouse-visual {
    display: flex;
    justify-content: center;
  }

  .warehouse-visual-wrap {
    position: relative;
    width: 100%;
    max-width: 360px;
  }

  .warehouse-panel {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 2.75rem 2rem;
    text-align: center;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  .warehouse-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    margin: 0 auto 1.25rem;
    color: var(--accent);
    background: rgba(0, 52, 120, 0.08);
    border: 1px solid rgba(0, 52, 120, 0.15);
    border-radius: var(--radius-sm);
  }

  .warehouse-panel-text {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .warehouse-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .warehouse-visual {
      order: -1;
    }

    .warehouse-visual-wrap {
      max-width: 100%;
    }
  }
</style>
