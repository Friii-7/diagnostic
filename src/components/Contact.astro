---
const address = 'Calle 42c #81-50, Medellín';
const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=Calle+42c+%2381-50+Medellin';
const catalogUrl = 'https://astounding-sopapillas-c8b423.netlify.app/';

const social = {
  instagram: 'https://www.instagram.com/diagnostic.s.ford/',
  facebook: 'https://facebook.com/',
  whatsapp: 'https://wa.me/573117800103',
};
---

<section id="contacto" class="section contact">
  <div class="section-atmosphere" aria-hidden="true">
    <span class="floating-shape floating-shape--md" style="top: 12%; left: 4%; animation-delay: 0s"></span>
    <span class="floating-shape floating-shape--sm" style="top: 48%; right: 6%; animation-delay: 2s"></span>
    <span class="floating-shape floating-shape--lg" style="bottom: 8%; left: 14%; animation-delay: 4s"></span>
  </div>

  <div class="container">
    <div class="contact-wrapper">
      <div class="contact-info">
        <span class="section-label reveal" style="--reveal-delay: 0.05s">Contacto</span>
        <h2 class="section-title reveal" style="--reveal-delay: 0.15s">Agende su diagnóstico hoy</h2>
        <p class="contact-desc reveal" style="--reveal-delay: 0.25s">
          No deje que una falla menor se convierta en un problema costoso. Visítenos y reciba un diagnóstico honesto con la atención que su vehículo merece.
        </p>

        <div class="contact-details">
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="contact-item reveal" style="--reveal-delay: 0.35s">
            <span class="contact-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </span>
            <span>
              <strong>Ubicación</strong>
              {address}
            </span>
          </a>

          <div class="contact-item reveal" style="--reveal-delay: 0.43s">
            <span class="contact-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 6v6l4 2"/>
              </svg>
            </span>
            <span>
              <strong>Horario</strong>
              Lunes a Sábado · 8:00 AM – 6:00 PM
            </span>
          </div>

          <div class="contact-item reveal" style="--reveal-delay: 0.51s">
            <span class="contact-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 16H9m10 0h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2h-1l-2-4H7L5 9H4a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1"/>
                <circle cx="7.5" cy="16.5" r="2.5"/>
                <circle cx="16.5" cy="16.5" r="2.5"/>
              </svg>
            </span>
            <span>
              <strong>Especialidad</strong>
              Diagnóstico y reparación · Vehículos Ford
            </span>
          </div>
        </div>

        <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary reveal" style="--reveal-delay: 0.59s">
          Cómo llegar
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
          </svg>
        </a>
      </div>

      <div class="contact-map reveal-right" style="--reveal-delay: 0.18s">
        <iframe
          title="Ubicación Diagnostic.S Motors en Medellín"
          src="https://maps.google.com/maps?q=Calle+42c+%2381-50,+Medell%C3%ADn,+Colombia&hl=es&z=16&output=embed"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
        <div class="map-overlay">
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="map-link btn-lift">
            Ver en Google Maps →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container footer-inner">
    <nav class="footer-social" aria-label="Redes sociales">
      <a
        href={social.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-icon footer-icon--instagram"
        aria-label="Instagram"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.85-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
        </svg>
      </a>

      <a
        href={social.facebook}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-icon footer-icon--facebook"
        aria-label="Facebook"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
      </a>

      <a
        href={social.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-icon footer-icon--whatsapp"
        aria-label="WhatsApp"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
        </svg>
      </a>
    </nav>

    <p class="footer-copy">© {new Date().getFullYear()} Diagnostic.S Motors</p>
  </div>
</footer>

<div class="floating-actions">
  <a
    href={catalogUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="float-compare"
    aria-label="Comparar repuestos"
    title="Comparar repuestos"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10 3H4a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h6"/>
      <path d="M14 3h6a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1h-6"/>
      <path d="M10 12H4M14 8h6M14 16h6"/>
    </svg>
  </a>

  <div class="float-whatsapp-wrap">
    <a
      href={social.whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      class="float-whatsapp"
      aria-label="Contactar por WhatsApp"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
      </svg>
    </a>
  </div>

  <button type="button" class="scroll-top" id="scroll-top" aria-label="Volver arriba">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 19V5M5 12l7-7 7 7"/>
    </svg>
  </button>
</div>

<script>
  const scrollTopBtn = document.getElementById('scroll-top');

  window.addEventListener('scroll', () => {
    scrollTopBtn?.classList.toggle('visible', window.scrollY > 400);
  });

  scrollTopBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>

<style>
  .contact {
    position: relative;
    overflow: clip;
  }

  .contact > .container {
    position: relative;
    z-index: 1;
  }

  .contact-wrapper {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3rem;
    align-items: center;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 3rem;
    box-shadow: var(--shadow-lg);
  }

  .contact-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    margin: 1rem 0 2rem;
    line-height: 1.7;
    max-width: 440px;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
    transition: color 0.2s, transform 0.3s ease;
  }

  a.contact-item:hover {
    color: var(--accent);
    transform: translateY(-2px);
  }

  .contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    background: rgba(0, 52, 120, 0.08);
    border: 1px solid rgba(0, 52, 120, 0.15);
    border-radius: var(--radius-sm);
    color: var(--accent);
  }

  .contact-item strong {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: 0.2rem;
  }

  .contact-item span:last-child {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .contact-map {
    position: relative;
    height: 360px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-secondary);
  }

  .contact-map iframe {
    width: 100%;
    height: 100%;
    filter: grayscale(30%) contrast(1.1);
  }

  .map-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1rem;
    background: linear-gradient(transparent, rgba(255, 255, 255, 0.95));
    text-align: center;
  }

  .map-link {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .map-link:hover {
    color: var(--accent-light);
  }

  .footer {
    padding: 2.5rem 0;
    background: linear-gradient(180deg, var(--bg-primary) 0%, var(--bg-secondary) 100%);
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .footer-social {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    text-decoration: none;
    color: var(--accent);
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--border);
    box-shadow: 0 4px 16px rgba(0, 52, 120, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease, color 0.25s ease, background 0.25s ease;
  }

  .footer-icon:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 52, 120, 0.15);
  }

  .footer-icon--instagram:hover {
    color: #fff;
    background: linear-gradient(135deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
    border-color: transparent;
  }

  .footer-icon--facebook:hover {
    color: #fff;
    background: #1877f2;
    border-color: transparent;
  }

  .footer-icon--whatsapp:hover {
    color: #fff;
    background: #25d366;
    border-color: transparent;
  }

  .footer-copy {
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .floating-actions {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 90;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .float-compare {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 4px;
    color: #fff;
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-light) 100%);
    box-shadow: 0 6px 24px rgba(0, 52, 120, 0.35);
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .float-compare:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 32px rgba(0, 52, 120, 0.45);
  }

  .float-whatsapp-wrap {
    position: relative;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .float-whatsapp-wrap::before,
  .float-whatsapp-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(37, 211, 102, 0.4);
    pointer-events: none;
    animation: whatsapp-pulse 2.2s ease-out infinite;
  }

  .float-whatsapp-wrap::after {
    animation-delay: 1.1s;
  }

  @keyframes whatsapp-pulse {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    70% {
      opacity: 0.15;
    }
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  .float-whatsapp {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 4px;
    color: #fff;
    background: #25d366;
    box-shadow: 0 6px 24px rgba(37, 211, 102, 0.4);
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .float-whatsapp:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 32px rgba(37, 211, 102, 0.5);
  }

  .scroll-top {
    display: none;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    color: #fff;
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-light) 100%);
    box-shadow: 0 6px 24px rgba(0, 52, 120, 0.35);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .scroll-top.visible {
    display: flex;
  }

  .scroll-top:hover {
    box-shadow: 0 10px 32px rgba(0, 52, 120, 0.45);
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .contact-wrapper {
      grid-template-columns: 1fr;
      padding: 2rem;
    }

    .contact-map {
      height: 280px;
    }

    .floating-actions {
      right: 1rem;
      bottom: 1rem;
    }

    .float-compare,
    .float-whatsapp-wrap,
    .float-whatsapp,
    .scroll-top {
      width: 44px;
      height: 44px;
    }
  }
</style>
